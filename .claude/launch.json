{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "project-self-tracker/src/SelfTracker.Api"
      ],
      "port": 5080
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "project-self-tracker/web",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}