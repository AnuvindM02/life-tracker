<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Public API docs are not required for an app; keep the noise down. -->
    <NoWarn>$(NoWarn);CA1848;CA1716;CA1711;CA1720;CA1819;CA1062;CA1515;CA2007;CA1031;CA1724;CA1307;CA1309;CA1310;CA1305;CA1304;CA1311;CA1862;CA1056;CA1054;CA1055;CA2227;CA1002;CA1034;CA1707;CA1852;CA1024;CA5394;CA1708;CA1822;CA1725;CA1873</NoWarn>
  </PropertyGroup>
</Project>
